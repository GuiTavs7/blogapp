<h2>Lista de categorias:</h2>
<hr>
<a href="/admin/categorias/add" class="btn btn-success">Adicionar Categoria</a>

{{#each categorias}}
    <div class="card card-m3 mt-4">
        <div class="card-body">
            <h4 class="card-title">{{nome}}</h4>
            <small class="card-text">Slug: {{slug}}</small><br>
            <small>Data de criação: {{date}}</small> <br>
            <a href="/admin/categorias/edit/{{_id}}"><button class="btn btn-success mt-4">Editar</button></a>
            <form action="/admin/categorias/delete/{{_id}}" method="POST">
                <input type="hidden" name="_id" value="{{_id}}">
                <button type="submit" class="btn btn-danger mt-2">Excluir</button>
            </form>
        </div>
    </div>
{{else}}
    <h4 class="text-center mt-3">Nenhuma categoria cadastrada.</h4>
{{/each}}