<h2>Lista de postagens:</h2>
<hr>
<a href="/admin/postagens/add" class="btn btn-success">Adicionar Postagem</a>

{{#each postagens}}
    <div class="card card-m3 mt-4">
        <div class="card-body">
            <h4 class="card-title">{{titulo}}</h4>
            {{#if imagem}}
                <img src="/uploads/{{imagem}}" alt="{{titulo}}" class="img-fluid rounded mb-3">
            {{/if}}
            <p>Descrição: {{descricao}}</p>
            <small class="card-text">Slug: {{slug}}</small><br>
            <small>Data de criação: {{data}}</small> <br>
            <small>Categoria: {{categoria.nome}}</small> <br>
            <a href="/admin/postagens/edit/{{_id}}"><button class="btn btn-success mt-4">Editar</button></a>
            <!-- Formulário de deletar postagens -->
            <form action="/admin/postagens/delete/{{_id}}" method="POST">
                <input type="hidden" name="_id" value="{{_id}}">
                <button type="submit" class="btn btn-danger mt-2">Excluir</button>
            </form>
        </div>
    </div>
{{else}}
    <h4 class="text-center mt-3">Nenhuma postagem cadastrada.</h4>
{{/each}}