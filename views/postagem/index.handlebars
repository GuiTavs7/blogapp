<div class="card">
    <div class="card-body">
        <h1>{{postagem.titulo}}</h1>
        <hr>
        <small>📆 {{formatarData data}}</small>
        <hr>
        {{#if postagem.imagem}}
            <img src="/uploads/{{postagem.imagem}}" alt="{{postagem.titulo}}" class="img-fluid rounded mb-3">
            <br>
        {{/if}}
        {{postagem.conteudo}}
    </div>
</div>