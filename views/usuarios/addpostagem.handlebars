{{#each erros}}
    <div class="alert alert-danger">
        {{texto}}
    </div>
{{/each}}

<div class="card">
    <div class="card-body">
        <h4>Nova postagem:</h4>
        <form action="/usuarios/postagens/nova" method="POST">
            <label for="titulo">Título:</label>
            <input type="text" name="titulo" id="titulo" class="form-control">
            <label for="slug">Slug:</label>
            <input type="text" name="slug" id="slug" class="form-control">
            <label for="descricao">Descrição:</label>
            <input type="text" name="descricao" id="descricao" class="form-control">
            <label for="conteudo">Conteúdo:</label>
            <textarea name="conteudo" id="conteudo" class="form-control"></textarea>
            <label for="categoria">Categoria:</label>
            <select name="categoria" id="categoria" class="form-control custom-select mt-2">
                {{#each categorias}}
                    <option value="{{this._id}}">{{this.nome}}</option>
                {{else}}
                    <option value="0">Nenhuma categoria encontrada</option>
                {{/each}}
            </select>
            <button class="btn btn-success mt-2" type="submit">Salvar Postagem</button>
        </form>
    </div>
</div>