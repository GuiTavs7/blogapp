{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{else}}
{{/each}}

<h3>Crie sua Conta</h3>

<div class="card">
    <div class="card-body">
        <form action="" method="post">
            <label for="nome">Nome: </label>
                <input type="text" name="nome" class="form-control" required>
            <label for="email">E-mail: </label>
                <input type="email" name="email" class="form-control" reqired>
            <label for="senha">Senha: </label>
                <input type="password" name="senha" class="form-control" reqired>
            <label for="senha2">Repita a sua senha: </label>
                <input type="password" name="senha2" class="form-control" reqired>
            <button type="submit" class="btn btn-success mt-4">Criar Conta</button>
        </form>
    </div>
</div>