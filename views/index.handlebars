<div class="jumbotron text-center shadow-sm p-3">
    <h1 class="display-4">Bem-vindo ao Blog do Node!</h1>
    <p class="lead">
        Compartilhe suas ideias, conhecimentos e experiências com a comunidade.
    </p>
    <hr class="my-4">
    <p>
        Crie sua conta gratuitamente e comece a publicar seus próprios conteúdos.
        Aqui você pode aprender, compartilhar e acompanhar novas publicações (este 
        é um blog simples, desenvolvido com Node.js + Express + MongoDB).
    </p>
    {{#if user}}
        <a class="btn btn-primary btn-lg" href="/usuarios/postagens/add" role="button">
            Criar nova postagem
        </a>
    {{else}}
        <a class="btn btn-primary btn-lg" href="/usuarios/login" role="button">
            Faça login
        </a>
        <a class="btn btn-primary btn-lg" href="/usuarios/registro" role="button">
            Crie sua conta
        </a>
    {{/if}}
</div>

<hr>

<form action="/" method="GET">
    <div class="input-group mb-3 gap-2">
        <input type="text" class="form-control" placeholder="Buscar postagens..." name="busca" value="{{busca}}">
        <div class="input-group-append">
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
        </div>
    </div>
</form>

{{#if busca}}
    <h5>Resultados da busca por: "{{busca}}"</h5>
{{/if}}

<h2>Postagens Recentes</h2>

{{#each postagens}}
    <div class="card bg-light card-margin mt-4">
        <div class="card-body">
            <h3>{{titulo}}</h3>
            <p>{{descricao}}</p>
            {{#if imagem}}
                <img src="{{imagem}}" alt="{{titulo}}" class="img-fluid postagem-imagem rounded mb-3">
                <br>
            {{/if}}
            <a href="/postagem/{{slug}}"><button class="btn btn-success">Leia mais</button></a>
            <hr>
            <small>Categoria: {{categoria.nome}}</small> <br>
            <small>📆 {{formatarData data}}</small>
        </div>
    </div>
{{else}}
    {{#if busca}}
        <h5>Nenhuma postagem encontrada para "{{busca}}".</h5>
    {{else}}
        <h5>Nenhuma postagem cadastrada.</h5>
    {{/if}}
{{/each}}